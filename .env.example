# SEKA / Sentinel Agent — local-first configuration
# The model, embeddings, chat history and knowledge store run on this machine.
# Network research, GitHub operations and optional notifications are separate
# capabilities; keep them disabled unless you explicitly need them.

# Ollama (local inference; no hosted model API)
OLLAMA_BASE_URL=http://ollama:11434  # Docker Compose service name; native Python users should set localhost
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_MODEL_FAST=qwen2.5:7b
OLLAMA_MODEL_DEEP=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Behavior: all write/push operations require explicit approval by default
REQUIRE_APPROVAL=true
WATCH_REPOS=

# Nightly local maintenance (03:00 Europe/Istanbul; reports/proposals only)
SEKA_NIGHT_AUTORUN=true
SEKA_NIGHT_HOUR=3
SEKA_NIGHT_MINUTE=0
SEKA_TIMEZONE=Europe/Istanbul
SEKA_NIGHT_RUN_TESTS=true
SEKA_NIGHT_CHECK_TIMEOUT_SECONDS=180

# Energy (optional)
OFF_PEAK_START_HOUR=0
OFF_PEAK_END_HOUR=7
STRICT_ENERGY=false
FORCE_HEAVY_JOBS=false

# Web security — authentication is ON by default. Set a strong unique password.
WEB_PORT=8000
AUTH_REQUIRED=true
OWNER_PASSWORD=

# Network capabilities are optional. Leave credentials empty for local-only use.
# Adding a GitHub token permits selected GitHub operations and sends requests to GitHub.
GITHUB_TOKEN=

# External web search is OFF by default to keep prompts/topics on-device.
# Set true only when you explicitly accept sending search queries to public search providers.
ALLOW_WEB_RESEARCH=false

# External market data and website scanning are also OFF by default.
ALLOW_EXTERNAL_FINANCE_DATA=false
ALLOW_SITE_SCANNING=false

# Optional local Stable Diffusion endpoint (only if self-hosted)
SD_API_URL=

# Optional third-party notification integration; leave empty for private local use.
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
ALLOW_EXTERNAL_NOTIFICATIONS=false

# Local Turkish voice (optional; never downloads models at runtime)
PIPER_EXECUTABLE=piper
SEKA_VOICE_MODEL_DIR=./models/voices
# Docker Compose overrides this to /app/models/voices
SEKA_VOICE_MALE_MODEL=tr_TR-fettah-medium.onnx
SEKA_VOICE_FEMALE_MODEL=tr_TR-dfki-medium.onnx
FASTER_WHISPER_MODEL_PATH=./models/whisper-small
# Docker Compose overrides this to /app/models/whisper-small
# Alternative whisper.cpp binary/model (optional)
WHISPER_CPP_BIN=whisper-cli
WHISPER_MODEL_PATH=

# Disable optional telemetry/tracing for local-first use.
ANONYMIZED_TELEMETRY=False
CHROMA_TELEMETRY=False
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
OTEL_SDK_DISABLED=true
