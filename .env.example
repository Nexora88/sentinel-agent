# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:32b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Agent Behavior
SCAN_SCHEDULE=0 3 * * *
AUTO_COMMIT=false
AUTO_PR=false
REQUIRE_APPROVAL=true

# Repositories to watch (comma separated)
WATCH_REPOS=

# Web UI
WEB_PORT=8000

# WhatsApp notifications (optional - CallMeBot free)
# 1. Add +34 644 21 99 05 to contacts
# 2. Send: I allow callmebot to send me messages
# 3. Put the received key here
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
