# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:32b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Agent Behavior
SCAN_SCHEDULE=0 3 * * *          # Every day at 03:00
AUTO_COMMIT=false                # Never auto-commit without permission
AUTO_PR=false
REQUIRE_APPROVAL=true

# Repositories to watch (comma separated)
WATCH_REPOS=owner/repo1,owner/repo2

# Notification (optional)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Security Tools
ENABLE_BANDIT=true
ENABLE_SEMGREP=true
ENABLE_TRIVY=true
