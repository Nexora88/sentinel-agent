# Ollama (required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_MODEL_FAST=qwen2.5-coder:7b
OLLAMA_MODEL_DEEP=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Behavior
REQUIRE_APPROVAL=true
WATCH_REPOS=

# Energy (optional)
OFF_PEAK_START_HOUR=0
OFF_PEAK_END_HOUR=7
STRICT_ENERGY=false
FORCE_HEAVY_JOBS=false

# Web
WEB_PORT=8000
AUTH_REQUIRED=false
OWNER_PASSWORD=

# GitHub (optional)
GITHUB_TOKEN=

# Optional local Stable Diffusion
SD_API_URL=

# WhatsApp (CallMeBot optional)
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
