# Ollama (required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Behavior
REQUIRE_APPROVAL=true
WATCH_REPOS=

# Web
WEB_PORT=8000
AUTH_REQUIRED=false
# Set a strong password before exposing the UI
OWNER_PASSWORD=

# GitHub (optional — write/push/PR)
GITHUB_TOKEN=

# Optional local Stable Diffusion (Automatic1111)
SD_API_URL=

# WhatsApp notifications (CallMeBot — optional)
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

# NEVER enable unless you fully understand the risk. Default is paper-only.
# REAL_TRADING_ENABLED=false
