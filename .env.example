# Chat defaults to the configured local inference server. No model is downloaded automatically; configure a compatible local server/model first.
MKAOS_CHAT_BACKEND=local-server
MKAOS_NATIVE_GENERATOR=/usr/local/bin/mkaos-generate
MKAOS_NATIVE_CHECKPOINT=/app/models/mkaos/model.mkaosw
MKAOS_NATIVE_SHA256=
# Optional local bundle manifest; verifies checkpoint and tokenizer hashes before native inference.
# Leave empty for legacy checkpoint-only verification until a bundle manifest is produced.
MKAOS_NATIVE_MANIFEST=
MKAOS_NATIVE_HEADS=4
MKAOS_NATIVE_KV_HEADS=2
MKAOS_NATIVE_MAX_SEQ=2048
MKAOS_NATIVE_MAX_NEW_TOKENS=256
MKAOS_NATIVE_TIMEOUT_SECONDS=90
# Optional legacy endpoint; only start the third-party service with the legacy-third-party-chat Compose profile.
MKAOS_BASE_URL=http://mkaos:11435
MKAOS_MODEL_NAME=mkaos-local
MKAOS_REPETITION_PENALTY=1.10
MKAOS_TEMPERATURE=0.15
MKAOS_TOP_P=0.9
# RAG defaults to a pre-installed local multilingual semantic model; no runtime downloads.
# Prepare model files and SHA-256 inventory as documented in docs/MKAOS_RAG_SEMANTIC_SETUP.md.
SEKA_REQUIRE_SEMANTIC_EMBEDDINGS=true
SEKA_LOCAL_EMBEDDING_MODEL_PATH=/app/models/embeddings/paraphrase-multilingual-MiniLM-L12-v2
SEKA_LOCAL_EMBEDDING_MANIFEST=/app/models/embeddings/embedding-manifest.json
SEKA_EMBEDDING_DEVICE=cpu
# Explicit legacy-only option: requires the legacy-ollama-embeddings Compose profile.
SEKA_EMBEDDINGS_PROVIDER=local-semantic
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
REQUIRE_APPROVAL=true
WATCH_REPOS=
SEKA_NIGHT_AUTORUN=true
SEKA_NIGHT_HOUR=3
SEKA_NIGHT_MINUTE=0
SEKA_TIMEZONE=Europe/Istanbul
SEKA_NIGHT_RUN_TESTS=true
SEKA_NIGHT_CHECK_TIMEOUT_SECONDS=180
OFF_PEAK_START_HOUR=0
OFF_PEAK_END_HOUR=7
STRICT_ENERGY=false
FORCE_HEAVY_JOBS=false
WEB_PORT=8000
AUTH_REQUIRED=true
OWNER_PASSWORD=
MKAOS_ENCRYPT_MEMORY_FILES=false
MKAOS_ENCRYPT_PERSONAL_PROFILE=false
MKAOS_MEMORY_KEY=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=MKAOS Sentinel
WEBAUTHN_ORIGIN=http://localhost:8000
REQUIRE_HTTPS=true
TRUST_PROXY_HEADERS=false
GITHUB_TOKEN=
ALLOW_WEB_RESEARCH=false
ALLOW_EXTERNAL_FINANCE_DATA=false
ALLOW_SITE_SCANNING=false
SD_API_URL=
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
ALLOW_EXTERNAL_NOTIFICATIONS=false
PIPER_EXECUTABLE=piper
SEKA_VOICE_MODEL_DIR=./models/voices
SEKA_VOICE_MALE_MODEL=tr_TR-fettah-medium.onnx
SEKA_VOICE_FEMALE_MODEL=tr_TR-dfki-medium.onnx
FASTER_WHISPER_MODEL_PATH=./models/whisper-small
WHISPER_CPP_BIN=whisper-cli
WHISPER_MODEL_PATH=
ANONYMIZED_TELEMETRY=False
CHROMA_TELEMETRY=False
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
OTEL_SDK_DISABLED=true
U2NET_HOME=./models/u2net
MKAOS_APPROVAL_ED25519_PUBLIC_KEY=
MKAOS_EGRESS_ATTESTATION_FILE=
MKAOS_MEDIA_MIN_FREE_RAM_MB=2048

# Optional PostgreSQL encrypted sessions/memory adapter (not wired as the default store yet).
MKAOS_POSTGRES_DSN=
# Generate a fresh 32-byte key locally; never commit or log its value.
MKAOS_MEMORY_ENCRYPTION_KEY=
