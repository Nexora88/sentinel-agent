# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:32b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Agent Behavior
SCAN_SCHEDULE=0 3 * * *
AUTO_COMMIT=false
