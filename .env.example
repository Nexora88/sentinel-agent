# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:32b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Agent Behavior
SCAN_SCHEDULE=0 3 * * *
AUTO_COMMIT=false
AUTO_PR=false
REQUIRE_APPROVAL=true

# Repositories to watch (comma separated)
WATCH_REPOS=

# WhatsApp (CallMeBot - free, outbound notifications only)
# 1. Add +34 644 21 99 05 to your contacts
# 2. Send: I allow callmebot to send me messages
# 3. You will receive an API key
WHATSAPP_PHONE=905xxxxxxxxx
WHATSAPP_APIKEY=

# Telegram Bot (bidirectional, private, phone + PC)
# 1. Talk to @BotFather → /newbot → get token
# 2. Talk to @userinfobot → get your user_id
# 3. Put both below. Only this user_id can talk to the agent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Optional extras
DISCORD_WEBHOOK_URL=
TELEGRAM_CHAT_ID=
