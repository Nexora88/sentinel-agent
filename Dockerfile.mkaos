# Dedicated resident MKAOS inference service.
# Model artifacts are mounted read-only at runtime; they are not copied into the image.
FROM rust:1.85-slim AS build
WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config cmake ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY engine ./engine
RUN cargo build --release --manifest-path engine/mkaos-hf-adapter/Cargo.toml --bin mkaos_server

FROM rust:1.85-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/engine/mkaos-hf-adapter/target/release/mkaos_server /usr/local/bin/mkaos_server
RUN useradd --system --uid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin mkaos
USER 10001:10001
EXPOSE 11435
ENTRYPOINT ["/usr/local/bin/mkaos_server"]
CMD ["/models", "0.0.0.0:11435"]
